Task 2: Configure Misconfigured Storage Buckets
Step 1: Install MinIO Client
# Download MinIO client
wget https://dl.min.io/client/mc/release/linux-amd64/mc
chmod +x mc
sudo mv mc /usr/local/bin/

# Verify installation
mc --version
Step 2: Configure MinIO Client Connection
# Add MinIO server as an alias
mc alias set localminio http://localhost:9000 minioadmin minioadmin

# Verify connection
mc admin info localminio
Step 3: Create Buckets with Different Access Levels
# Create a private bucket (correct configuration)
mc mb localminio/private-bucket

# Create a public bucket (MISCONFIGURED - security risk!)
mc mb localminio/public-bucket

# Create another public bucket for testing
mc mb localminio/exposed-data
Step 4: Upload Sensitive Files
# Upload to private bucket
mc cp ~/sensitive-data/customer-data.txt localminio/private-bucket/

# Upload to public buckets (MISCONFIGURATION!)
mc cp ~/sensitive-data/api-keys.txt localminio/public-bucket/
mc cp ~/sensitive-data/financial-report.txt localminio/exposed-data/
Step 5: Apply Misconfigured Public Access Policies
# Set public read access (DANGEROUS!)
mc anonymous set download localminio/public-bucket

# Set public read access to exposed-data bucket
mc anonymous set download localminio/exposed-data

# Verify bucket policies
mc anonymous list localminio/public-bucket
mc anonymous list localminio/exposed-data
mc anonymous list localminio/private-bucket
Expected Output:

public-bucket and exposed-data should show "download" access
private-bucket should show no anonymous access
Task 3: Detect and Verify Public Access Exposure
Step 1: List All Buckets and Check Policies
# List all buckets
mc ls localminio/

# Check each bucket's policy
echo "=== Checking Bucket Policies ==="
for bucket in private-bucket public-bucket exposed-data; do
    echo "Bucket: $bucket"
    mc anonymous list localminio/$bucket
    echo "---"
done
Step 2: Test Public Access Without Authentication
# Try to access public bucket files without credentials
echo "=== Testing Public Access ==="

# This should SUCCEED (security issue!)
curl -I http://localhost:9000/public-bucket/api-keys.txt

# Download the exposed file
curl http://localhost:9000/public-bucket/api-keys.txt

# Test exposed-data bucket
curl http://localhost:9000/exposed-data/financial-report.txt
Step 3: Test Private Bucket Access
# This should FAIL (correct behavior)
echo "=== Testing Private Bucket ==="
curl -I http://localhost:9000/private-bucket/customer-data.txt
Expected Output:

Public buckets return HTTP 200 and file contents
Private bucket returns HTTP 403 (Access Denied)
Step 4: Create Detection Script
Create a simple script to scan for exposed storage:

cat > ~/storage-scanner.sh << 'EOF'
#!/bin/bash
# Simple Object Storage Exposure Scanner

echo "==================================="
echo "Storage Exposure Detection Scanner"
echo "==================================="
echo ""

MINIO_HOST="http://localhost:9000"
BUCKETS=("private-bucket" "public-bucket" "exposed-data")

for bucket in "${BUCKETS[@]}"; do
    echo "Scanning bucket: $bucket"
    
    # Try to list bucket contents
    response=$(curl -s -o /dev/null -w "%{http_code}" "$MINIO_HOST/$bucket/")
    
    if [ "$response" == "200" ] || [ "$response" == "403" ]; then
        # Try to access a known file
        mc ls localminio/$bucket/ 2>/dev/null | while read -r line; do
            filename=$(echo $line | awk '{print $NF}')
            if [ ! -z "$filename" ]; then
                file_response=$(curl -s -o /dev/null -w "%{http_code}" "$MINIO_HOST/$bucket/$filename")
                if [ "$file_response" == "200" ]; then
                    echo "  [EXPOSED] $filename is publicly accessible!"
                else
                    echo "  [SECURE] $filename is protected"
                fi
            fi
        done
    fi
    echo ""
done

echo "==================================="
echo "Scan Complete"
echo "==================================="
EOF

chmod +x ~/storage-scanner.sh
Step 5: Run the Detection Script
# Execute the scanner
~/storage-scanner.sh
Step 6: Generate Exposure Report
cat > ~/generate-report.sh << 'EOF'
#!/bin/bash
# Generate exposure report

REPORT_FILE=~/exposure-report.txt

echo "Object Storage Exposure Report" > $REPORT_FILE
echo "Generated: $(date)" >> $REPORT_FILE
echo "================================" >> $REPORT_FILE
echo "" >> $REPORT_FILE

# Check each bucket
for bucket in private-bucket public-bucket exposed-data; do
    echo "Bucket: $bucket" >> $REPORT_FILE
    policy=$(mc anonymous list localminio/$bucket 2>/dev/null)
    
    if echo "$policy" | grep -q "download"; then
        echo "  Status: EXPOSED - Public read access enabled" >> $REPORT_FILE
        echo "  Risk Level: HIGH" >> $REPORT_FILE
    else
        echo "  Status: SECURE - No public access" >> $REPORT_FILE
        echo "  Risk Level: LOW" >> $REPORT_FILE
    fi
    echo "" >> $REPORT_FILE
done

cat $REPORT_FILE
EOF

chmod +x ~/generate-report.sh
~/generate-report.sh
