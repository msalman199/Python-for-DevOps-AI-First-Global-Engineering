    name: "Failed Login Attempts"
    pattern: "FAILED_LOGIN"
    threshold: 3
    severity: "HIGH"
    response: "block_ip"
    
  - id: 2
    name: "Suspicious File Access"
    pattern: "UNAUTHORIZED_ACCESS"
    threshold: 1
    severity: "CRITICAL"
    response: "alert_admin"
    
  - id: 3
