Task 1: Understanding the Security Problem
Step 1: Create an Insecure Script
First, let's see why hardcoding credentials is dangerous.

# Create a project directory
mkdir ~/secure-config-lab
cd ~/secure-config-lab

# Create an insecure script
nano insecure_db.py
Add the following code:

#!/usr/bin/env python3
"""
Insecure database connection example - DO NOT USE IN PRODUCTION
This demonstrates the security risk of hardcoding credentials
"""

def connect_to_database():
    """
    Connects to database using hardcoded credentials (INSECURE!)
    """
    # Hardcoded credentials - SECURITY RISK!
    db_host = "localhost"
    db_port = "5432"
    db_name = "myapp_db"
    db_user = "admin"
    db_password = "SuperSecret123!"  # Exposed in code!
    
    # Simulate connection string
    connection_string = f"postgresql://{db_user}:{db_password}@{db_host}:{db_port}/{db_name}"
    
    print("Attempting database connection...")
    print(f"Connection String: {connection_string}")
    print("\nWARNING: Credentials are hardcoded and visible in source code!")
    
    return connection_string

if __name__ == "__main__":
    connect_to_database()
Save and exit (Ctrl+X, then Y, then Enter).

Step 2: Run the Insecure Script
# Make it executable
chmod +x insecure_db.py

# Run the script
python3 insecure_db.py
Observe: The password is visible in the code and output. Anyone with access to this file can see the credentials.

Task 2: Implementing Secure Configuration
Step 1: Install python-dotenv
# Install the python-dotenv library
pip3 install python-dotenv
Step 2: Create a .env File
The .env file stores sensitive configuration outside your code.

# Create the .env file
nano .env
Add the following configuration:

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=admin
DB_PASSWORD=SuperSecret123!

# Application Settings
APP_ENV=development
DEBUG_MODE=true
Save and exit.

Step 3: Secure the .env File
# Restrict file permissions (owner read/write only)
chmod 600 .env

# Verify permissions
ls -la .env
You should see: -rw------- (only owner can read/write)

Step 4: Create .gitignore File
Prevent accidentally committing secrets to version control.

# Create .gitignore
nano .gitignore
Add:

# Environment variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
Save and exit.

Step 5: Create Secure Script
Now create a script that loads credentials from environment variables.

nano secure_db.py
Add the following code:

#!/usr/bin/env python3
"""
Secure database connection using environment variables
"""

import os
from dotenv import load_dotenv

def load_configuration():
    """
    Load configuration from .env file
    
    Returns:
        bool: True if .env file loaded successfully
    """
    # Load environment variables from .env file
    load_dotenv()
    
    # Verify critical variables are loaded
    required_vars = ['DB_HOST', 'DB_USER', 'DB_PASSWORD', 'DB_NAME']
    
    for var in required_vars:
        if not os.getenv(var):
            print(f"ERROR: Required variable {var} not found!")
            return False
    
    print("Configuration loaded successfully from .env file")
    return True

def connect_to_database():
    """
    Connects to database using environment variables (SECURE)
    """
    # Retrieve credentials from environment variables
    db_host = os.getenv('DB_HOST')
    db_port = os.getenv('DB_PORT', '5432')  # Default port if not specified
    db_name = os.getenv('DB_NAME')
    db_user = os.getenv('DB_USER')
    db_password = os.getenv('DB_PASSWORD')
    
    # Create connection string
    # Note: In production, use proper database libraries with connection pooling
    connection_string = f"postgresql://{db_user}:{'*' * len(db_password)}@{db_host}:{db_port}/{db_name}"
    
    print("\nDatabase Connection Details:")
    print(f"Host: {db_host}")
    print(f"Port: {db_port}")
    print(f"Database: {db_name}")
    print(f"User: {db_user}")
    print(f"Password: {'*' * len(db_password)} (hidden)")
    print(f"\nConnection String: {connection_string}")
    print("\nSUCCESS: Credentials loaded securely from environment!")
    
    return True

def display_app_settings():
    """
    Display non-sensitive application settings
    """
    app_env = os.getenv('APP_ENV', 'production')
    debug_mode = os.getenv('DEBUG_MODE', 'false')
    
    print("\nApplication Settings:")
    print(f"Environment: {app_env}")
    print(f"Debug Mode: {debug_mode}")

if __name__ == "__main__":
    print("=== Secure Configuration Demo ===\n")
    
    # Load configuration
    if load_configuration():
        # Connect to database
        connect_to_database()
        
        # Display app settings
        display_app_settings()
    else:
        print("Failed to load configuration. Exiting.")
        exit(1)
Save and exit.

