Step 3: Understand the Vulnerabilities
Review each vulnerability type:

SQL Injection: Attackers can manipulate queries

Example malicious input: admin' OR '1'='1
Path Traversal: Attackers can access unauthorized files

Example malicious input: ../../etc/passwd
Command Injection: Attackers can execute arbitrary commands

Example malicious input: google.com; cat /etc/passwd
Task 2: Refactor and Harden the Code
Step 1: Create Secure Version of user_login.py
cat > user_login_secure.py << 'EOF'
import sqlite3
import hashlib

def hash_password(password):
    """
    Hash password using SHA-256.
    In production, use bcrypt or argon2.
    """
    return hashlib.sha256(password.encode()).hexdigest()

def authenticate_user(username, password):
    """
    Securely authenticate user against database.
    SECURE: Uses parameterized queries.
    """
    conn = sqlite3.connect('users.db')
    cursor = conn.cursor()
    
    # SECURE: Parameterized query prevents SQL injection
    query = "SELECT * FROM users WHERE username=? AND password=?"
    hashed_pwd = hash_password(password)
    cursor.execute(query, (username, hashed_pwd))
    
    result = cursor.fetchone()
    conn.close()
    
    if result:
        return True
    return False

# Input validation function
def validate_username(username):
    """
    Validate username format.
    """
    if not username or len(username) > 50:
        return False
    # Allow only alphanumeric and underscore
    return username.replace('_', '').isalnum()

if __name__ == "__main__":
    user = input("Enter username: ")
    
    # Validate input before processing
    if not validate_username(user):
        print("Invalid username format!")
        exit(1)
    
    pwd = input("Enter password: ")
    
    if authenticate_user(user, pwd):
        print("Login successful!")
    else:
        print("Login failed!")
EOF
Step 2: Create Secure Version of file_reader.py
cat > file_reader_secure.py << 'EOF'
import os
from pathlib import Path

def read_user_file(filename):
    """
    Securely read a file from the user uploads directory.
    SECURE: Validates path to prevent traversal attacks.
    """
    base_path = Path("/tmp/uploads/").resolve()
    
    # Sanitize filename - remove path components
    safe_filename = os.path.basename(filename)
    
    # Construct full path
    file_path = (base_path / safe_filename).resolve()
    
    # SECURE: Verify the resolved path is within base directory
    try:
        file_path.relative_to(base_path)
    except ValueError:
        return "Error: Access denied - path traversal detected!"
    
    # Additional check: file must exist and be a file
    if not file_path.exists() or not file_path.is_file():
        return "Error: File not found!"
    
    try:
        with open(file_path, 'r') as f:
            return f.read()
    except Exception as e:
        return f"Error: {str(e)}"

if __name__ == "__main__":
    file = input("Enter filename to read: ")
    content = read_user_file(file)
    print(content)
EOF
Step 3: Create Secure Version of command_executor.py
cat > command_executor_secure.py << 'EOF'
import subprocess
import re

def validate_hostname(hostname):
    """
    Validate hostname format.
    """
    # Allow only valid hostname characters
    pattern = r'^[a-zA-Z0-9.-]+$'
    if not re.match(pattern, hostname):
        return False
    if len(hostname) > 253:
        return False
    return True

def ping_host(hostname):
    """
    Securely ping a hostname and return results.
    SECURE: Uses subprocess with argument list, validates input.
    """
    # Validate input
    if not validate_hostname(hostname):
        print("Error: Invalid hostname format!")
        return 1
    
    try:
        # SECURE: Use list of arguments instead of shell string
        result = subprocess.run(
            ['ping', '-c', '4', hostname],
            capture_output=True,
            text=True,
            timeout=10,
            check=False
        )
        
        print(result.stdout)
        return result.returncode
        
    except subprocess.TimeoutExpired:
        print("Error: Ping timeout!")
        return 1
    except Exception as e:
        print(f"Error: {str(e)}")
        return 1

if __name__ == "__main__":
    host = input("Enter hostname to ping: ")
    ping_host(host)
EOF
