Task 1: Install VS Code and Essential Extensions
Step 1: Install VS Code
# Update package list
sudo apt update

# Install dependencies
sudo apt install -y wget gpg apt-transport-https

# Add Microsoft GPG key and repository
wget -qO- https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > packages.microsoft.gpg
sudo install -o root -g root -m 644 packages.microsoft.gpg /etc/apt/trusted.gpg.d/
sudo sh -c 'echo "deb [arch=amd64] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list'

# Install VS Code
sudo apt update
sudo apt install -y code

# Verify installation
code --version
Step 2: Launch VS Code
# Start VS Code (use & to run in background)
code . &
Note: If running on a headless server, you can use VS Code Server or configure X11 forwarding. For this lab, we'll focus on command-line configuration.

Step 3: Install Python Extensions via CLI
# Install Python extension
code --install-extension ms-python.python

# Install Pylance for enhanced language support
code --install-extension ms-python.vscode-pylance

# Install Python Debugger
code --install-extension ms-python.debugpy

# Install additional productivity extensions
code --install-extension ms-python.black-formatter
code --install-extension ms-toolsai.jupyter

# List installed extensions
code --list-extensions
Step 4: Create Workspace Configuration
Create a project directory and configuration:

# Create project directory
mkdir -p ~/python-workspace
cd ~/python-workspace

# Create VS Code settings directory
mkdir -p .vscode
Create .vscode/settings.json:

cat > .vscode/settings.json << 'EOF'
{
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.formatting.provider": "black",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "editor.formatOnSave": true,
    "editor.rulers": [88],
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000
}
EOF
Task 2: Setup Virtual Environments and Configure Debugger
Step 1: Install Python and Virtual Environment Tools
# Install Python and pip
sudo apt install -y python3 python3-pip python3-venv

# Verify installation
python3 --version
pip3 --version
Step 2: Create and Activate Virtual Environment
# Navigate to workspace
cd ~/python-workspace

# Create virtual environment
python3 -m venv venv

# Activate virtual environment
source venv/bin/activate

# Verify activation (should show venv path)
which python
Step 3: Install Development Dependencies
# Upgrade pip
pip install --upgrade pip

# Install common development tools
pip install pylint black pytest ipython

# Create requirements file
pip freeze > requirements.txt

# View installed packages
pip list
