def debug_function(func):
    """
    Decorator to enable debugging for a function.
    
    Usage:
        @debug_function
        def my_function():
            pass
    """
    def wrapper(*args, **kwargs):
        print(f"Debugging {func.__name__}")
        pdb.set_trace()
        return func(*args, **kwargs)
    return wrapper


