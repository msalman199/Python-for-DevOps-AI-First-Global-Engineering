#!/usr/bin/env python3
"""
Log Security Analyzer
Detects suspicious activities in log files
"""

import re
import json
from collections import defaultdict

def analyze_auth_logs(log_file):
    """
    Analyze authentication logs for suspicious activity.
    
    Args:
        log_file: Path to authentication log file
    
    Returns:
        Dictionary with security findings
    """
    findings = []
    failed_attempts = defaultdict(int)
    
    # TODO: Read and parse log file
    with open(log_file, 'r') as f:
        for line in f:
            # TODO: Detect failed login attempts
            if 'Failed login attempt' in line:
                # Extract IP address
                ip_match = re.search(r'from (\d+\.\d+\.\d+\.\d+)', line)
                if ip_match:
                    ip = ip_match.group(1)
                    failed_attempts[ip] += 1
            
            # TODO: Detect brute force attacks
            if 'Brute force attack' in line:
                findings.append({
                    'severity': 'CRITICAL',
                    'type': 'Brute Force Attack',
                    'details': line.strip()
                })
    
    # TODO: Flag IPs with multiple failed attempts
    for ip, count in failed_attempts.items():
        if count >= 3:
            findings.append({
                'severity': 'HIGH',
                'type': 'Multiple Failed Logins',
                'details': f"IP {ip} had {count} failed login attempts"
            })
    
    return findings

def analyze_access_logs(log_file):
    """
    Analyze access logs for unauthorized access attempts.
    
    Args:
        log_file: Path to access log file
    
    Returns:
        List of security findings
    """
    findings = []
    
    # TODO: Read and parse access log
    with open(log_file, 'r') as f:
        for line in f:
            # TODO: Check for 403 Forbidden responses
            if '403' in line:
                findings.append({
                    'severity': 'MEDIUM',
                    'type': 'Unauthorized Access Attempt',
                    'details': line.strip()
                })
            
            # TODO: Check for sensitive endpoint access
            if '/admin/' in line or '/api/secrets' in line:
                findings.append({
                    'severity': 'MEDIUM',
                    'type': 'Sensitive Endpoint Access',
                    'details': line.strip()
                })
            
            # TODO: Check for DELETE operations
            if 'DELETE' in line:
                findings.append({
                    'severity': 'LOW',
                    'type': 'Delete Operation',
                    'details': line.strip()
                })
    
    return findings

def main():
    """Main execution function"""
    print("=" * 60)
    print("LOG SECURITY AUDIT")
    print("=" * 60)
    
    all_findings = []
    
    # Analyze authentication logs
    print("\n[*] Analyzing Authentication Logs...")
    auth_findings = analyze_auth_logs('logs/auth.log')
    all_findings.extend(auth_findings)
    
    # Analyze access logs
    print("[*] Analyzing Access Logs...")
    access_findings = analyze_access_logs('logs/access.log')
    all_findings.extend(access_findings)
    
    # Display results
    print(f"\n[*] Total Security Events: {len(all_findings)}")
    print("\nDETAILED FINDINGS:")
    print("-" * 60)
    
    # Group by severity
    critical = [f for f in all_findings if f['severity'] == 'CRITICAL']
    high = [f for f in all_findings if f['severity'] == 'HIGH']
    medium = [f for f in all_findings if f['severity'] == 'MEDIUM']
    low = [f for f in all_findings if f['severity'] == 'LOW']
    
    for severity, findings in [('CRITICAL', critical), ('HIGH', high), 
                                ('MEDIUM', medium), ('LOW', low)]:
        if findings:
            print(f"\n{severity} SEVERITY ({len(findings)}):")
            for finding in findings:
                print(f"  - {finding['type']}: {finding['details']}")
    
    # Save report
    with open('reports/log_audit.json', 'w') as f:
        json.dump(all_findings, f, indent=2)
    
    print(f"\n[*] Report saved to reports/log_audit.json")

if __name__ == '__main__':
    main()
EOF

