Step 3: Collect Evidence with Integrity Preservation
# Copy evidence to original directory with verification
cd ~/forensics_lab

# Use dcfldd for forensically sound copying
dcfldd if=suspicious_doc.txt of=evidence/original/suspicious_doc.txt hash=md5,sha256 hashlog=evidence/hashes/suspicious_doc.hash

dcfldd if=system.log of=evidence/original/system.log hash=md5,sha256 hashlog=evidence/hashes/system.log.hash

dcfldd if=app.conf of=evidence/original/app.conf hash=md5,sha256 hashlog=evidence/hashes/app.conf.hash

# Make original evidence read-only
chmod 444 evidence/original/*

# Create working copies
cp -p evidence/original/* evidence/working/
Step 4: Generate Hash Manifest
# Create comprehensive hash manifest
cd ~/forensics_lab/evidence/original

# Generate MD5 hashes
md5deep -r . > ../hashes/md5_manifest.txt

# Generate SHA256 hashes
sha256sum * > ../hashes/sha256_manifest.txt

# Display hash manifest
echo "=== Hash Manifest ==="
cat ../hashes/sha256_manifest.txt
Step 5: Create Chain of Custody Log
# Create chain of custody template
cat > ~/forensics_lab/evidence/logs/chain_of_custody.log << 'EOF'
CHAIN OF CUSTODY LOG
=====================
Case ID: CASE-2024-001
Evidence Collection Date: $(date)
Collected By: Lab Student
Location: Forensics Lab Environment

EVIDENCE ITEMS:
---------------
EOF

# Add evidence items with timestamps
cd ~/forensics_lab/evidence/original
for file in *; do
    echo "Item: $file" >> ../logs/chain_of_custody.log
    echo "  Collected: $(date)" >> ../logs/chain_of_custody.log
    echo "  Size: $(stat -f%z "$file" 2>/dev/null || stat -c%s "$file")" >> ../logs/chain_of_custody.log
    echo "  SHA256: $(sha256sum "$file" | awk '{print $1}')" >> ../logs/chain_of_custody.log
    echo "" >> ../logs/chain_of_custody.log
done

# Display chain of custody
cat ../logs/chain_of_custody.log
