Save and exit (Ctrl+X, Y, Enter in nano).

Step 2: Identify the Bugs
Review the script and identify these issues:

Security Issues:

Hardcoded password in plaintext
Command injection vulnerability in list_users()
No input validation allowing malicious input
Logic Errors:

Authentication uses OR instead of AND (line 9)
Missing newline character when writing users (line 20)
Code Quality Issues:

No error handling for file operations
Files not closed properly (no context managers)
No input validation for menu choices
Step 3: Create the Fixed Version
Create a new file for the corrected script:

nano user_manager_fixed.py
Now implement the fixed version. Use this template and complete the TODO sections:

#!/usr/bin/env python3
import os
import sys
import hashlib
import subprocess

# TODO: Replace hardcoded password with environment variable or config file
# Hint: Use os.environ.get() or a configuration file
ADMIN_PASSWORD_HASH = hashlib.sha256("admin123".encode()).hexdigest()

def authenticate_user(username, password):
    """
    Authenticate user with proper logic.
    
    Args:
        username: The username to authenticate
        password: The password to verify
    
    Returns:
        bool: True if authenticated, False otherwise
    """
    # TODO: Fix the logic error - should use AND not OR
    # TODO: Hash the input password and compare with stored hash
    password_hash = hashlib.sha256(password.encode()).hexdigest()
    if username == "admin" and password_hash == ADMIN_PASSWORD_HASH:
        return True
    return False

def list_users():
    """
    List system users safely without command injection.
    """
    # TODO: Replace os.system() with subprocess.run() for safety
    # TODO: Use a fixed command without user input concatenation
    try:
        result = subprocess.run(
            ["grep", "/bin/bash", "/etc/passwd"],
            capture_output=True,
            text=True,
            timeout=5
        )
        print(result.stdout)
    except subprocess.TimeoutExpired:
        print("Command timed out")
    except Exception as e:
        print(f"Error listing users: {e}")

def add_user(username):
    """
    Add user to list with validation and proper file handling.
    
    Args:
        username: The username to add
    """
    # TODO: Add input validation (alphanumeric only, length check)
    if not username.isalnum() or len(username) < 3 or len(username) > 20:
        print("Invalid username. Use 3-20 alphanumeric characters.")
        return
    
    # TODO: Use context manager (with statement) for file handling
    # TODO: Add newline character when writing
    try:
        with open("/tmp/users.txt", "a") as file:
            file.write(username + "\n")
        print(f"User '{username}' added successfully")
    except IOError as e:
        print(f"Error writing to file: {e}")

def read_users():
    """
    Read users from file with error handling.
    
    Returns:
        str: Contents of user file or error message
    """
    # TODO: Add try-except block for file not found
    # TODO: Use context manager for file handling
    try:
        with open("/tmp/users.txt", "r") as file:
            users = file.read()
        return users if users else "No users found"
    except FileNotFoundError:
        return "User file not found. Add users first."
    except IOError as e:
        return f"Error reading file: {e}"

def main():
    """Main function with input validation."""
    print("User Management System (Secure Version)")
    print("1. Authenticate")
    print("2. List system users")
    print("3. Add user to list")
    print("4. Read user list")
    print("5. Exit")
    
    # TODO: Add input validation for menu choice
    choice = input("Enter choice (1-5): ").strip()
    
    if not choice.isdigit() or int(choice) not in range(1, 6):
        print("Invalid choice. Please enter 1-5.")
        return
    
    choice = int(choice)
    
    if choice == 1:
        user = input("Username: ").strip()
        pwd = input("Password: ").strip()
        if authenticate_user(user, pwd):
            print("Access granted")
        else:
            print("Access denied")
    elif choice == 2:
        list_users()
    elif choice == 3:
        name = input("Enter username: ").strip()
        add_user(name)
    elif choice == 4:
        print(read_users())
    elif choice == 5:
        print("Exiting...")
        sys.exit(0)

if __name__ == "__main__":
    main()
Save and exit.

