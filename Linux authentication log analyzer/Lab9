#!/bin/bash
# Complete Authentication Log Analyzer
# Usage: ./auth_analyzer.sh [logfile]

LOGFILE=${1:-/var/log/auth.log}

echo "========================================"
echo "  AUTHENTICATION LOG ANALYSIS REPORT"
echo "========================================"
echo "Log File: $LOGFILE"
echo "Generated: $(date)"
echo ""

# Section 1: Summary Statistics
